# =====================================================================
# __APP_NAME__ — production env (VPS Hostinger)
# =====================================================================
# Copie ce fichier en .env sur le VPS et remplis les valeurs.
# Ne JAMAIS le committer.

NODE_ENV=production
PORT=__APP_PORT__
PUBLIC_URL=https://__PUBLIC_HOST__

# Database (Postgres / MySQL / etc.)
# DATABASE_URL=postgres://USER:PASSWORD@HOST/db?sslmode=require

# Auth
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Email
# RESEND_API_KEY=
# EMAIL_FROM=

# Storage
# BLOB_READ_WRITE_TOKEN=

# Cron secret
# CRON_SECRET=
