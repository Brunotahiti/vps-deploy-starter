# =====================================================================
# ManaResto — production (VPS Hostinger). Copier en .env sur le VPS. NE JAMAIS committer.
# =====================================================================
APP_NAME=manaresto
PUBLIC_HOST=app.manaresto.com
# Ancien domaine encore accepté par l'application (facultatif)
PUBLIC_HOST_ALT=manaresto.manaprocess.cloud
PUBLIC_URL=https://manaresto.pf
NODE_ENV=production

# PostgreSQL (container db) — générer : openssl rand -base64 24 | tr -d '/+=' | head -c 32
POSTGRES_USER=manaresto
POSTGRES_DB=manaresto
POSTGRES_PASSWORD=CHANGEZ-MOI
# DATABASE_URL est composée automatiquement par docker-compose.yml à partir des valeurs ci-dessus.

# Secret de session (32+ caractères aléatoires) — openssl rand -base64 32
SESSION_SECRET=CHANGEZ-MOI
SESSION_TTL_HOURS=12

# Créer le restaurant de démonstration « Le Mana Beach » au premier déploiement (true/false)
SEED_DEMO=false

# E-mails (reçus, invitations, bienvenue, fin d'essai, console) : relais SMTP Brevo, expéditeur contact@manaresto.com
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=identifiant-smtp-brevo
# SMTP_PASS=cle-smtp-brevo
# SMTP_FROM="ManaResto <contact@manaresto.com>"

# Console plateforme /platform (adresses des comptes administrateurs ManaResto, séparées par des virgules)
# PLATFORM_ADMIN_EMAILS=contact@manaresto.com

# Suivi des erreurs Sentry (facultatif) : DSN du projet « manaresto » (Sentry → Settings → Projects → manaresto → Client Keys)
# SENTRY_DSN=https://xxxxxxxx@o000000.ingest.us.sentry.io/0000000
# SENTRY_ENVIRONMENT=production
# Jeton (scope project:releases) pour téléverser les source maps au build — facultatif
# SENTRY_AUTH_TOKEN=

# Limites mémoire des conteneurs (serveur partagé avec d'autres sites). Valeurs par défaut si absentes.
# APP_MEM_LIMIT=768m
# DB_MEM_LIMIT=512m
# MIGRATE_MEM_LIMIT=512m

# Temps réel partagé entre plusieurs instances (Phase 7) — facultatif
# REDIS_URL=redis://manaresto-redis:6379

# Site vitrine (statique, servi par nginx via Traefik) : www redirige depuis l'apex
SITE_HOST=www.manaresto.com
SITE_HOST_ALT=manaresto.com
