# =====================================================================
# ManaResto — production (VPS Hostinger). Copier en .env sur le VPS. NE JAMAIS committer.
# =====================================================================
APP_NAME=manaresto
PUBLIC_HOST=manaresto.pf
PUBLIC_URL=https://manaresto.pf
NODE_ENV=production

# PostgreSQL (container db) — générer : openssl rand -base64 24 | tr -d '/+=' | head -c 32
POSTGRES_USER=manaresto
POSTGRES_DB=manaresto
POSTGRES_PASSWORD=CHANGEZ-MOI
# DATABASE_URL est composée automatiquement par docker-compose.yml à partir des valeurs ci-dessus.

# Secret de session (32+ caractères aléatoires) — openssl rand -base64 32
SESSION_SECRET=CHANGEZ-MOI
SESSION_TTL_HOURS=12

# Créer le restaurant de démonstration « Le Mana Beach » au premier déploiement (true/false)
SEED_DEMO=false

# Envoi des reçus PDF par e-mail (facultatif). Exemple Hostinger : smtp.hostinger.com, port 465, SMTP_SECURE=true
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=contact@votre-restaurant.pf
# SMTP_PASS=
# SMTP_FROM="Le Mana Beach <contact@votre-restaurant.pf>"

# Limites mémoire des conteneurs (serveur partagé avec d'autres sites). Valeurs par défaut si absentes.
# APP_MEM_LIMIT=768m
# DB_MEM_LIMIT=512m
# MIGRATE_MEM_LIMIT=512m
