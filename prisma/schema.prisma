// ManaResto — schéma de base de données
// Tous les montants sont stockés en entiers dans l'unité mineure de la devise
// (XPF : exposant 0 → 1 = 1 F CFP). Les taux (TVA, %) sont en points de base (bps).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// TENANCY : Compte → Entreprise (organization) → Établissement → Zones/Caisses
// ---------------------------------------------------------------------------

enum Plan {
  TRIAL // essai gratuit (15 jours)
  ACTIVE // abonnement actif
  SUSPENDED // suspendu (impayé, résiliation)
}

model Organization {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  slug          String    @unique
  plan          Plan      @default(TRIAL)
  trialEndsAt   DateTime? @map("trial_ends_at")
  planStartedAt DateTime? @map("plan_started_at")
  billingEmail  String?   @map("billing_email")
  periodEndsAt  DateTime? @map("period_ends_at") // fin de la période d'abonnement en cours (engagement)
  blockedAt     DateTime? @map("blocked_at") // compte bloqué depuis la console plateforme
  blockedReason String?   @map("blocked_reason")
  /// Options payantes débloquées : "stock", "digital", "team", "advanced" (programme de base sans option)
  options       String[]  @default([])
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  establishments Establishment[]
  users          User[]
  roles          Role[]
  customers      Customer[]
  auditLogs      AuditLog[]

  apiKeys        ApiKey[]
  activityDays   ActivityDay[]
  platformEmails PlatformEmail[]
  optionRequests OptionRequest[]

  @@map("organizations")
}

model Establishment {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  name             String
  slug             String
  legalName        String?  @map("legal_name")
  tahitiNumber     String?  @map("tahiti_number") // N° Tahiti (registre des entreprises PF)
  addressLine1     String?  @map("address_line1")
  addressLine2     String?  @map("address_line2")
  city             String?
  postalCode       String?  @map("postal_code")
  island           String?
  country          String   @default("PF")
  phone            String?
  email            String?
  currency         String   @default("XPF")
  currencyExponent Int      @default(0) @map("currency_exponent")
  locale           String   @default("fr-PF")
  timezone         String   @default("Pacific/Tahiti")
  tipsEnabled      Boolean  @default(false) @map("tips_enabled")
  tipPresetsBps    Json     @default("[500,1000,1500]") @map("tip_presets_bps")
  openingHours     Json?    @map("opening_hours")
  settings         Json     @default("{}")
  onboardingStep   Int      @default(0) @map("onboarding_step")
  onboardingDone   Boolean  @default(false) @map("onboarding_done")
  /// Type d'activité : "snack" (roulotte, comptoir), "restaurant" (service à table) ou "bar" ; adapte l'écran et les réglages conseillés
  businessType     String   @default("restaurant") @map("business_type")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships         UserEstablishment[]
  terminals           Terminal[]
  offlinePinKeys      OfflinePinKey[]
  offlinePasses       OfflinePass[]
  boxes               LocalBox[]
  rooms               Room[]
  tables              Table[]
  categories          Category[]
  products            Product[]
  modifierGroups      ModifierGroup[]
  menus               Menu[]
  taxRates            TaxRate[]
  kitchenStations     KitchenStation[]
  printers            Printer[]
  apiKeys             ApiKey[]
  webhooks            Webhook[]
  serviceSteps        TableServiceStep[]
  serviceReminders    ServiceReminder[]
  uploads             Upload[]
  paymentMethods      PaymentMethodConfig[]
  orders              Order[]
  payments            Payment[]
  cashSessions        CashSession[]
  ingredients         Ingredient[]
  inventoryMovements  InventoryMovement[]
  suppliers           Supplier[]
  purchaseOrders      PurchaseOrder[]
  employees           Employee[]
  shifts              Shift[]
  timeEntries         TimeEntry[]
  reservations        Reservation[]
  loyaltyAccounts     LoyaltyAccount[]
  auditLogs           AuditLog[]
  idempotencyKeys     IdempotencyKey[]
  orderCounters       OrderCounter[]
  hygieneEquipment    HygieneEquipment[]
  temperatureReadings TemperatureReading[]
  cleaningTasks       CleaningTask[]
  cleaningLogs        CleaningLog[]
  traceRecords        TraceRecord[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("establishments")
}

// ---------------------------------------------------------------------------
// UTILISATEURS, RÔLES, PERMISSIONS, SESSIONS, TERMINAUX
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  pinHash         String?   @map("pin_hash")
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  displayName     String?   @map("display_name")
  color           String?
  isOwner         Boolean   @default(false) @map("is_owner")
  isActive        Boolean   @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at")
  inviteToken     String?   @unique @map("invite_token") // invitation par e-mail en attente
  inviteExpiresAt DateTime? @map("invite_expires_at")
  invitedAt       DateTime? @map("invited_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships         UserEstablishment[]
  sessions            Session[]
  offlinePinKeys      OfflinePinKey[]
  offlinePasses       OfflinePass[]
  employee            Employee?
  ordersServed        Order[]              @relation("OrderServer")
  payments            Payment[]            @relation("PaymentReceivedBy")
  cashOpened          CashSession[]        @relation("CashOpenedBy")
  cashClosed          CashSession[]        @relation("CashClosedBy")
  cashMovements       CashMovement[]
  auditLogs           AuditLog[]
  refunds             Refund[]
  inventoryMovements  InventoryMovement[]
  activityDays        ActivityDay[]
  temperatureReadings TemperatureReading[]
  cleaningLogs        CleaningLog[]
  traceRecords        TraceRecord[]

  @@index([organizationId])
  @@map("users")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String // owner, manager, cashier, server, bartender, kitchen, accountant, custom
  name           String
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  UserEstablishment[]

  @@unique([organizationId, key])
  @@map("roles")
}

model Permission {
  key         String @id
  group       String
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model UserEstablishment {
  userId          String   @map("user_id") @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  roleId          String   @map("role_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  role          Role          @relation(fields: [roleId], references: [id])

  @@id([userId, establishmentId])
  @@index([establishmentId])
  @@map("user_establishments")
}

model Session {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  tokenHash       String   @unique @map("token_hash")
  establishmentId String?  @map("establishment_id") @db.Uuid
  terminalId      String?  @map("terminal_id") @db.Uuid
  ip              String?
  userAgent       String?  @map("user_agent")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  lastSeenAt      DateTime @default(now()) @map("last_seen_at")
  impersonatorId  String?  @map("impersonator_id") @db.Uuid // administrateur ManaResto en mode « prendre la main »
  /// « pos » : session limitée à la caisse de son établissement (ouverte par un boîtier de secours)
  scope           String?
  boxId           String?  @map("box_id") @db.Uuid // boîtier qui a ouvert la session : supprimée quand il est retiré

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  box  LocalBox? @relation(fields: [boxId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Connexion sans internet : clé dérivée du PIN (PBKDF2), calculée quand le serveur voit le PIN en clair
/// (connexion par PIN, autorisation manager, PIN défini). Elle chiffre les laissez-passer hors ligne.
model OfflinePinKey {
  userId          String   @map("user_id") @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  key             Bytes
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@id([userId, establishmentId])
  @@map("offline_pin_keys")
}

/// Laissez-passer hors ligne d'un employé sur un terminal : remis chiffré par la clé de son PIN,
/// il authentifie ses opérations rejouées au retour du réseau (en-tête X-Offline-Pass).
model OfflinePass {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  establishmentId String    @map("establishment_id") @db.Uuid
  terminalId      String    @map("terminal_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  terminal      Terminal      @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  @@index([userId, terminalId])
  @@map("offline_passes")
}

/// Boîtier local (mini-PC sur le Wi-Fi du restaurant) : relais de secours pendant les coupures d'internet.
/// Il garde une copie du restaurant (GET /api/box/snapshot, jeton du boîtier) et prend le relais sans internet.
model LocalBox {
  id              String    @id @default(uuid()) @db.Uuid
  establishmentId String    @map("establishment_id") @db.Uuid
  name            String
  tokenHash       String    @unique @map("token_hash")
  createdById     String?   @map("created_by_id") @db.Uuid
  lastSeenAt      DateTime? @map("last_seen_at")
  lastIp          String?   @map("last_ip")
  lanIp           String?   @map("lan_ip")
  version         String?
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  sessions      Session[]

  @@index([establishmentId])
  @@map("local_boxes")
}

enum TerminalKind {
  POS
  KDS
  KIOSK
  MANAGER
}

model Terminal {
  id              String       @id @default(uuid()) @db.Uuid
  establishmentId String       @map("establishment_id") @db.Uuid
  name            String
  kind            TerminalKind @default(POS)
  deviceKeyHash   String       @unique @map("device_key_hash")
  isActive        Boolean      @default(true) @map("is_active")
  lastSeenAt      DateTime?    @map("last_seen_at")
  createdAt       DateTime     @default(now()) @map("created_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  orders        Order[]
  cashSessions  CashSession[]
  auditLogs     AuditLog[]
  printers      Printer[]
  offlinePasses OfflinePass[]

  @@index([establishmentId])
  @@map("terminals")
}

// ---------------------------------------------------------------------------
// SALLES ET TABLES
// ---------------------------------------------------------------------------

enum RoomKind {
  INDOOR
  TERRACE
  BAR
  OTHER
}

model Room {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  name            String
  kind            RoomKind @default(INDOOR)
  sortOrder       Int      @default(0) @map("sort_order")
  width           Int      @default(1200)
  height          Int      @default(800)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  tables        Table[]

  @@index([establishmentId])
  @@map("rooms")
}

enum TableShape {
  ROUND
  SQUARE
  RECT
}

enum TableState {
  FREE
  RESERVED
  TO_CLEAN
}

model Table {
  id              String     @id @default(uuid()) @db.Uuid
  establishmentId String     @map("establishment_id") @db.Uuid
  roomId          String     @map("room_id") @db.Uuid
  name            String
  seats           Int        @default(2)
  shape           TableShape @default(SQUARE)
  x               Int        @default(0)
  y               Int        @default(0)
  width           Int        @default(100)
  height          Int        @default(100)
  rotation        Int        @default(0)
  state           TableState @default(FREE)
  qrToken         String     @unique @default(uuid()) @map("qr_token")
  callRequestedAt DateTime?  @map("call_requested_at") // appel serveur depuis le QR code (Phase 6)
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  orders        Order[]
  reservations  Reservation[]

  @@unique([roomId, name])
  @@index([establishmentId])
  @@map("tables")
}

// ---------------------------------------------------------------------------
// CATALOGUE : TVA, catégories, produits, variantes, options, formules
// ---------------------------------------------------------------------------

model TaxRate {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  name            String
  rateBps         Int      @map("rate_bps") // 1600 = 16 %
  isDefault       Boolean  @default(false) @map("is_default")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  products      Product[]
  menus         Menu[]

  @@index([establishmentId])
  @@map("tax_rates")
}

model Category {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  parentId        String?  @map("parent_id") @db.Uuid
  name            String
  color           String   @default("#0EA5A4")
  imageUrl        String?  @map("image_url")
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  parent        Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      Category[]    @relation("CategoryTree")
  products      Product[]

  @@index([establishmentId, sortOrder])
  @@map("categories")
}

model KitchenStation {
  id              String  @id @default(uuid()) @db.Uuid
  establishmentId String  @map("establishment_id") @db.Uuid
  name            String // CUISINE, BAR, PIZZA, DESSERTS, GRILL, PASSE
  color           String  @default("#F97316")
  sortOrder       Int     @default(0) @map("sort_order")
  warnAfterSec    Int     @default(600) @map("warn_after_sec")
  alertAfterSec   Int     @default(900) @map("alert_after_sec")
  isActive        Boolean @default(true) @map("is_active")

  establishment  Establishment   @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  products       Product[]
  kitchenTickets KitchenTicket[]
  printers       Printer[]

  @@index([establishmentId])
  @@map("kitchen_stations")
}

enum PrinterKind {
  RECEIPT
  KITCHEN
}

model Printer {
  id              String      @id @default(uuid()) @db.Uuid
  establishmentId String      @map("establishment_id") @db.Uuid
  stationId       String?     @map("station_id") @db.Uuid
  name            String
  kind            PrinterKind @default(RECEIPT)
  driver          String      @default("escpos-network") // escpos-network | agent | cloud-epson | cloud-star | browser
  connection      Json        @default("{}")
  paperWidthMm    Int         @default(80) @map("paper_width_mm")
  isActive        Boolean     @default(true) @map("is_active")
  hasDrawer       Boolean     @default(false) @map("has_drawer") // tiroir-caisse branché sur l'imprimante (prise RJ11)
  drawerPin       Int         @default(2) @map("drawer_pin") // broche 2 ou 5 du connecteur tiroir
  terminalId      String?     @map("terminal_id") @db.Uuid // caisse servie en priorité par cette imprimante
  cloudTokenHash  String?     @unique @map("cloud_token_hash") // imprimantes connectées : jeton de l'adresse d'interrogation
  lastSeenAt      DateTime?   @map("last_seen_at")
  lastStatus      String?     @map("last_status")

  establishment Establishment   @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  station       KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  terminal      Terminal?       @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  jobs          PrintJob[]

  @@index([establishmentId])
  @@map("printers")
}

enum PrintJobStatus {
  PENDING
  SENT
  DONE
  FAILED
}

/**
 * File d'attente des imprimantes connectées (Epson Server Direct Print, Star CloudPRNT) : l'imprimante vient chercher ses travaux.
 */
model PrintJob {
  id              String         @id @default(uuid()) @db.Uuid
  establishmentId String         @map("establishment_id") @db.Uuid
  printerId       String         @map("printer_id") @db.Uuid
  kind            String // receipt | kitchen | test | drawer
  document        Json // suite d'opérations (texte, gras, coupe, tiroir…) encodée au format de l'imprimante à l'envoi
  status          PrintJobStatus @default(PENDING)
  error           String?
  createdAt       DateTime       @default(now()) @map("created_at")
  sentAt          DateTime?      @map("sent_at")
  doneAt          DateTime?      @map("done_at")

  printer Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  @@index([printerId, status, createdAt])
  @@map("print_jobs")
}

model Product {
  id               String   @id @default(uuid()) @db.Uuid
  establishmentId  String   @map("establishment_id") @db.Uuid
  categoryId       String?  @map("category_id") @db.Uuid
  taxRateId        String?  @map("tax_rate_id") @db.Uuid
  kitchenStationId String?  @map("kitchen_station_id") @db.Uuid
  name             String
  description      String?
  imageUrl         String?  @map("image_url")
  color            String?
  priceTtc         Int      @map("price_ttc")
  costPrice        Int      @default(0) @map("cost_price")
  sku              String?
  barcode          String?
  isAvailable      Boolean  @default(true) @map("is_available") // rupture manuelle
  autoUnavailable  Boolean  @default(false) @map("auto_unavailable") // rupture automatique (stock)
  availability     Json? // horaires de disponibilité { days:[1..7], from:"11:00", to:"14:30" }
  trackStock       Boolean  @default(false) @map("track_stock")
  stockQty         Int      @default(0) @map("stock_qty")
  stockMin         Int      @default(0) @map("stock_min")
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  establishment    Establishment          @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  category         Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  taxRate          TaxRate?               @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  kitchenStation   KitchenStation?        @relation(fields: [kitchenStationId], references: [id], onDelete: SetNull)
  variants         ProductVariant[]
  modifierGroups   ProductModifierGroup[]
  menuItems        MenuItem[]
  orderItems       OrderItem[]
  recipeLines      RecipeLine[]
  supplierProducts SupplierProduct[]

  @@unique([establishmentId, sku])
  @@index([establishmentId, categoryId])
  @@index([establishmentId, barcode])
  @@map("products")
}

model ProductVariant {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  name      String
  priceTtc  Int     @map("price_ttc")
  sku       String?
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ModifierGroup {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  name            String
  minSelect       Int      @default(0) @map("min_select") // >0 → obligatoire
  maxSelect       Int?     @map("max_select") // null → illimité ; 1 → choix unique
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  establishment Establishment          @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  modifiers     Modifier[]
  products      ProductModifierGroup[]

  @@index([establishmentId])
  @@map("modifier_groups")
}

model Modifier {
  id          String  @id @default(uuid()) @db.Uuid
  groupId     String  @map("group_id") @db.Uuid
  name        String
  priceDelta  Int     @default(0) @map("price_delta")
  isDefault   Boolean @default(false) @map("is_default")
  isAvailable Boolean @default(true) @map("is_available")
  sortOrder   Int     @default(0) @map("sort_order")

  group      ModifierGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orderItems OrderItemModifier[]

  @@index([groupId])
  @@map("modifiers")
}

model ProductModifierGroup {
  productId       String @map("product_id") @db.Uuid
  modifierGroupId String @map("modifier_group_id") @db.Uuid
  sortOrder       Int    @default(0) @map("sort_order")

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([productId, modifierGroupId])
  @@map("product_modifier_groups")
}

// Formules (Menu déjeuner 3 500 F : 1 entrée + 1 plat + 1 dessert)
model Menu {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  taxRateId       String?  @map("tax_rate_id") @db.Uuid
  name            String
  description     String?
  priceTtc        Int      @map("price_ttc")
  color           String?
  imageUrl        String?  @map("image_url")
  availability    Json?
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  taxRate       TaxRate?      @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  sections      MenuSection[]
  orderItems    OrderItem[]

  @@index([establishmentId])
  @@map("menus")
}

model MenuSection {
  id        String @id @default(uuid()) @db.Uuid
  menuId    String @map("menu_id") @db.Uuid
  name      String // Entrée, Plat, Dessert
  minSelect Int    @default(1) @map("min_select")
  maxSelect Int    @default(1) @map("max_select")
  sortOrder Int    @default(0) @map("sort_order")

  menu  Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items MenuItem[]

  @@index([menuId])
  @@map("menu_sections")
}

model MenuItem {
  id         String @id @default(uuid()) @db.Uuid
  sectionId  String @map("section_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid
  supplement Int    @default(0) // +500 F pour l'entrecôte
  sortOrder  Int    @default(0) @map("sort_order")

  section MenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([sectionId, productId])
  @@map("menu_items")
}

// ---------------------------------------------------------------------------
// CLIENTS, FIDÉLITÉ, RÉSERVATIONS
// ---------------------------------------------------------------------------

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  firstName      String?  @map("first_name")
  lastName       String?  @map("last_name")
  phone          String?
  email          String?
  notes          String?
  allergies      String?
  visitCount     Int      @default(0) @map("visit_count")
  totalSpent     Int      @default(0) @map("total_spent")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders          Order[]
  reservations    Reservation[]
  loyaltyAccounts LoyaltyAccount[]

  @@index([organizationId, phone])
  @@index([organizationId, email])
  @@map("customers")
}

model LoyaltyAccount {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  customerId      String   @map("customer_id") @db.Uuid
  points          Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  establishment Establishment        @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  customer      Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions  LoyaltyTransaction[]

  @@unique([establishmentId, customerId])
  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  orderId   String?  @map("order_id") @db.Uuid
  points    Int
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("loyalty_transactions")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ARRIVED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  establishmentId String            @map("establishment_id") @db.Uuid
  customerId      String?           @map("customer_id") @db.Uuid
  tableId         String?           @map("table_id") @db.Uuid
  name            String
  phone           String?
  email           String?
  startsAt        DateTime          @map("starts_at")
  partySize       Int               @map("party_size")
  status          ReservationStatus @default(PENDING)
  notes           String?
  allergies       String?
  durationMinutes Int               @default(90) @map("duration_minutes")
  source          String            @default("PHONE") // PHONE, WALK_IN, ONLINE, OTHER
  tags            String[]          @default([])
  createdByName   String?           @map("created_by_name") // prénom de la personne qui a pris la réservation
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  table         Table?        @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([establishmentId, startsAt])
  @@map("reservations")
}

// ---------------------------------------------------------------------------
// COMMANDES, SERVICES (courses), TICKETS CUISINE
// ---------------------------------------------------------------------------

enum OrderType {
  DINE_IN
  COUNTER
  TAKEAWAY
  DELIVERY
  ONLINE
  KIOSK
}

enum OrderStatus {
  OPEN // en cours de saisie
  SENT // au moins un service envoyé en cuisine
  BILL_REQUESTED // addition demandée
  PAID
  CANCELLED
}

model OrderCounter {
  establishmentId String @map("establishment_id") @db.Uuid
  day             String // YYYY-MM-DD (fuseau de l'établissement)
  value           Int    @default(0)

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@id([establishmentId, day])
  @@map("order_counters")
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  establishmentId String      @map("establishment_id") @db.Uuid
  number          String // ex. 20260929-0042
  type            OrderType   @default(DINE_IN)
  status          OrderStatus @default(OPEN)
  tableId         String?     @map("table_id") @db.Uuid
  serverId        String?     @map("server_id") @db.Uuid
  terminalId      String?     @map("terminal_id") @db.Uuid
  customerId      String?     @map("customer_id") @db.Uuid
  publicToken     String?     @unique @map("public_token") // suivi client (commande en ligne / QR)
  channelMeta     Json?       @map("channel_meta") // retrait / livraison / contact (Phase 6)
  acceptedAt      DateTime?   @map("accepted_at") // acceptation d'une commande en ligne par le restaurant
  customerName    String?     @map("customer_name")
  customerPhone   String?     @map("customer_phone") // à emporter : pour prévenir le client
  pickupAt        DateTime?   @map("pickup_at") // à emporter : heure de retrait souhaitée
  readyAt         DateTime?   @map("ready_at") // à emporter : commande prête (appel du numéro)
  pickedUpAt      DateTime?   @map("picked_up_at") // à emporter : remise au client (ou au livreur)
  covers          Int         @default(1)
  subtotal        Int         @default(0) // TTC avant remise
  discountTotal   Int         @default(0) @map("discount_total")
  discountReason  String?     @map("discount_reason")
  taxTotal        Int         @default(0) @map("tax_total")
  total           Int         @default(0) // TTC net à payer
  tipTotal        Int         @default(0) @map("tip_total")
  paidTotal       Int         @default(0) @map("paid_total")
  notes           String?
  cancelReason    String?     @map("cancel_reason")
  version         Int         @default(1) // concurrence optimiste / synchro hors ligne
  openedAt        DateTime    @default(now()) @map("opened_at")
  billRequestedAt DateTime?   @map("bill_requested_at")
  closedAt        DateTime?   @map("closed_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  establishment    Establishment      @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  table            Table?             @relation(fields: [tableId], references: [id], onDelete: SetNull)
  serviceSteps     TableServiceStep[]
  serviceReminders ServiceReminder[]
  server           User?              @relation("OrderServer", fields: [serverId], references: [id], onDelete: SetNull)
  terminal         Terminal?          @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  customer         Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  courses          Course[]
  kitchenTickets   KitchenTicket[]
  kitchenChanges   KitchenChange[]
  payments         Payment[]
  cashMovements    CashMovement[]

  @@unique([establishmentId, number])
  @@index([establishmentId, status])
  @@index([establishmentId, openedAt])
  @@index([establishmentId, type, openedAt])
  @@index([establishmentId, closedAt])
  @@index([tableId])
  @@map("orders")
}

enum CourseStatus {
  PENDING
  HOLD // "ne pas envoyer immédiatement"
  SENT
  FIRE // "faire marcher"
  READY
  SERVED
}

model Course {
  id        String       @id @default(uuid()) @db.Uuid
  orderId   String       @map("order_id") @db.Uuid
  name      String // APÉRITIFS, ENTRÉES, PLATS, DESSERTS
  sortOrder Int          @default(0) @map("sort_order")
  status    CourseStatus @default(PENDING)
  sentAt    DateTime?    @map("sent_at")
  firedAt   DateTime?    @map("fired_at")
  createdAt DateTime     @default(now()) @map("created_at")

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  kitchenTickets KitchenTicket[]

  @@index([orderId])
  @@map("courses")
}

enum OrderItemStatus {
  PENDING
  SENT
  PREPARING
  READY
  SERVED
  VOIDED
}

model OrderItem {
  id               String          @id @default(uuid()) @db.Uuid
  orderId          String          @map("order_id") @db.Uuid
  courseId         String?         @map("course_id") @db.Uuid
  productId        String?         @map("product_id") @db.Uuid
  variantId        String?         @map("variant_id") @db.Uuid
  menuId           String?         @map("menu_id") @db.Uuid
  parentItemId     String?         @map("parent_item_id") @db.Uuid // composant d'une formule
  kitchenStationId String?         @map("kitchen_station_id") @db.Uuid
  kitchenTicketId  String?         @map("kitchen_ticket_id") @db.Uuid
  name             String
  quantity         Int             @default(1)
  unitPrice        Int             @map("unit_price") // TTC, hors options
  modifiersTotal   Int             @default(0) @map("modifiers_total") // par unité
  discountAmount   Int             @default(0) @map("discount_amount")
  lineTotal        Int             @default(0) @map("line_total") // (unitPrice + modifiersTotal) * qty - discount
  taxRateBps       Int             @default(0) @map("tax_rate_bps")
  taxRateName      String?         @map("tax_rate_name")
  taxAmount        Int             @default(0) @map("tax_amount")
  costPrice        Int             @default(0) @map("cost_price")
  seatNumber       Int?            @map("seat_number") // null → table entière
  notes            String?
  isUrgent         Boolean         @default(false) @map("is_urgent")
  status           OrderItemStatus @default(PENDING)
  sentAt           DateTime?       @map("sent_at")
  readyAt          DateTime?       @map("ready_at")
  servedAt         DateTime?       @map("served_at")
  voidedAt         DateTime?       @map("voided_at")
  voidReason       String?         @map("void_reason")
  sortOrder        Int             @default(0) @map("sort_order")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  order         Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course        Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)
  product       Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant       ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  menu          Menu?               @relation(fields: [menuId], references: [id], onDelete: SetNull)
  parentItem    OrderItem?          @relation("MenuComponents", fields: [parentItemId], references: [id], onDelete: Cascade)
  components    OrderItem[]         @relation("MenuComponents")
  kitchenTicket KitchenTicket?      @relation(fields: [kitchenTicketId], references: [id], onDelete: SetNull)
  modifiers     OrderItemModifier[]

  @@index([orderId])
  @@index([kitchenTicketId])
  @@map("order_items")
}

model OrderItemModifier {
  id          String  @id @default(uuid()) @db.Uuid
  orderItemId String  @map("order_item_id") @db.Uuid
  modifierId  String? @map("modifier_id") @db.Uuid
  groupName   String? @map("group_name")
  name        String
  priceDelta  Int     @default(0) @map("price_delta")
  quantity    Int     @default(1)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifier  Modifier? @relation(fields: [modifierId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

enum KitchenTicketStatus {
  NEW
  ACCEPTED
  IN_PROGRESS
  READY
  DONE
  CANCELLED
}

model KitchenTicket {
  id          String              @id @default(uuid()) @db.Uuid
  orderId     String              @map("order_id") @db.Uuid
  courseId    String?             @map("course_id") @db.Uuid
  stationId   String?             @map("station_id") @db.Uuid
  status      KitchenTicketStatus @default(NEW)
  isUrgent    Boolean             @default(false) @map("is_urgent")
  createdAt   DateTime            @default(now()) @map("created_at")
  acceptedAt  DateTime?           @map("accepted_at")
  startedAt   DateTime?           @map("started_at")
  readyAt     DateTime?           @map("ready_at")
  completedAt DateTime?           @map("completed_at")

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course  Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  station KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  items   OrderItem[]

  @@index([stationId, status])
  @@index([orderId])
  @@map("kitchen_tickets")
}

// ---------------------------------------------------------------------------
// PAIEMENTS, REMBOURSEMENTS, CAISSE
// ---------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  CARD
  CHECK
  TRANSFER
  MEAL_VOUCHER
  COMPLIMENTARY
  OTHER
}

model PaymentMethodConfig {
  id              String        @id @default(uuid()) @db.Uuid
  establishmentId String        @map("establishment_id") @db.Uuid
  method          PaymentMethod
  label           String
  isEnabled       Boolean       @default(true) @map("is_enabled")
  opensDrawer     Boolean       @default(false) @map("opens_drawer")
  provider        String? // abstraction prestataire électronique (null = terminal externe)
  providerConfig  Json          @default("{}") @map("provider_config")
  sortOrder       Int           @default(0) @map("sort_order")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, method])
  @@map("payment_method_configs")
}

enum PaymentStatus {
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  establishmentId String        @map("establishment_id") @db.Uuid
  orderId         String        @map("order_id") @db.Uuid
  cashSessionId   String?       @map("cash_session_id") @db.Uuid
  receivedById    String?       @map("received_by_id") @db.Uuid
  method          PaymentMethod
  status          PaymentStatus @default(COMPLETED)
  amount          Int // montant imputé à l'addition
  tipAmount       Int           @default(0) @map("tip_amount")
  tendered        Int? // espèces reçues
  changeGiven     Int           @default(0) @map("change_given")
  refundedAmount  Int           @default(0) @map("refunded_amount")
  reference       String? // n° chèque, réf. TPE…
  splitLabel      String?       @map("split_label") // "Client 2", "Part 1/4"
  providerRef     String?       @map("provider_ref")
  createdAt       DateTime      @default(now()) @map("created_at")

  establishment Establishment  @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cashSession   CashSession?   @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  receivedBy    User?          @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  refunds       Refund[]
  cashMovements CashMovement[]

  @@index([orderId])
  @@index([establishmentId, createdAt])
  @@index([cashSessionId])
  @@map("payments")
}

model Refund {
  id         String   @id @default(uuid()) @db.Uuid
  paymentId  String   @map("payment_id") @db.Uuid
  issuedById String?  @map("issued_by_id") @db.Uuid
  amount     Int
  reason     String
  createdAt  DateTime @default(now()) @map("created_at")

  payment  Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  issuedBy User?   @relation(fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@map("refunds")
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

model CashSession {
  id              String            @id @default(uuid()) @db.Uuid
  establishmentId String            @map("establishment_id") @db.Uuid
  terminalId      String?           @map("terminal_id") @db.Uuid
  openedById      String            @map("opened_by_id") @db.Uuid
  closedById      String?           @map("closed_by_id") @db.Uuid
  status          CashSessionStatus @default(OPEN)
  openingFloat    Int               @map("opening_float")
  expectedCash    Int?              @map("expected_cash")
  countedCash     Int?              @map("counted_cash")
  difference      Int?
  notes           String?
  openedAt        DateTime          @default(now()) @map("opened_at")
  closedAt        DateTime?         @map("closed_at")

  establishment Establishment  @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  terminal      Terminal?      @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  openedBy      User           @relation("CashOpenedBy", fields: [openedById], references: [id])
  closedBy      User?          @relation("CashClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  payments      Payment[]
  movements     CashMovement[]

  @@index([establishmentId, status])
  @@map("cash_sessions")
}

enum CashMovementKind {
  OPENING
  SALE
  REFUND
  PAY_IN
  PAY_OUT
  DEPOSIT
  CORRECTION
  CLOSING
}

model CashMovement {
  id            String           @id @default(uuid()) @db.Uuid
  cashSessionId String           @map("cash_session_id") @db.Uuid
  userId        String?          @map("user_id") @db.Uuid
  paymentId     String?          @map("payment_id") @db.Uuid
  orderId       String?          @map("order_id") @db.Uuid
  kind          CashMovementKind
  amount        Int // signé : + entrée, − sortie
  reason        String?
  createdAt     DateTime         @default(now()) @map("created_at")

  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  payment     Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  order       Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([cashSessionId])
  @@map("cash_movements")
}

// ---------------------------------------------------------------------------
// STOCK : ingrédients, recettes, mouvements, fournisseurs, achats (Phase 4)
// ---------------------------------------------------------------------------

model Ingredient {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  name            String
  unit            String   @default("pce") // pce, g, kg, ml, l
  stockQty        Decimal  @default(0) @map("stock_qty") @db.Decimal(14, 3)
  stockMin        Decimal  @default(0) @map("stock_min") @db.Decimal(14, 3)
  avgCost         Int      @default(0) @map("avg_cost") // coût par unité
  lastCost        Int      @default(0) @map("last_cost")
  isCritical      Boolean  @default(false) @map("is_critical")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  establishment    Establishment       @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  recipeLines      RecipeLine[]
  movements        InventoryMovement[]
  supplierProducts SupplierProduct[]

  @@index([establishmentId])
  @@map("ingredients")
}

model RecipeLine {
  id           String  @id @default(uuid()) @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  ingredientId String  @map("ingredient_id") @db.Uuid
  quantity     Decimal @db.Decimal(14, 3)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
  @@map("recipes")
}

enum InventoryMovementKind {
  SALE
  PURCHASE
  ADJUSTMENT
  LOSS
  BREAKAGE
  INTERNAL_USE
  INVENTORY
}

model InventoryMovement {
  id              String                @id @default(uuid()) @db.Uuid
  establishmentId String                @map("establishment_id") @db.Uuid
  ingredientId    String                @map("ingredient_id") @db.Uuid
  userId          String?               @map("user_id") @db.Uuid
  kind            InventoryMovementKind
  quantity        Decimal               @db.Decimal(14, 3) // signée
  unitCost        Int?                  @map("unit_cost")
  reason          String?
  referenceId     String?               @map("reference_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([establishmentId, createdAt])
  @@index([ingredientId])
  @@map("inventory_movements")
}

model Supplier {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  name            String
  contactName     String?  @map("contact_name")
  phone           String?
  email           String?
  address         String?
  notes           String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  establishment  Establishment     @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  products       SupplierProduct[]
  purchaseOrders PurchaseOrder[]

  @@index([establishmentId])
  @@map("suppliers")
}

model SupplierProduct {
  id           String   @id @default(uuid()) @db.Uuid
  supplierId   String   @map("supplier_id") @db.Uuid
  ingredientId String?  @map("ingredient_id") @db.Uuid
  productId    String?  @map("product_id") @db.Uuid
  reference    String?
  name         String
  packSize     Decimal  @default(1) @map("pack_size") @db.Decimal(14, 3)
  lastPrice    Int      @default(0) @map("last_price")
  avgPrice     Int      @default(0) @map("avg_price")
  updatedAt    DateTime @updatedAt @map("updated_at")

  supplier   Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  ingredient Ingredient?         @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  product    Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  lines      PurchaseOrderLine[]

  @@index([supplierId])
  @@map("supplier_products")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id              String              @id @default(uuid()) @db.Uuid
  establishmentId String              @map("establishment_id") @db.Uuid
  supplierId      String              @map("supplier_id") @db.Uuid
  number          String
  status          PurchaseOrderStatus @default(DRAFT)
  expectedAt      DateTime?           @map("expected_at")
  receivedAt      DateTime?           @map("received_at")
  total           Int                 @default(0)
  notes           String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  establishment Establishment       @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  lines         PurchaseOrderLine[]

  @@unique([establishmentId, number])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id                String  @id @default(uuid()) @db.Uuid
  purchaseOrderId   String  @map("purchase_order_id") @db.Uuid
  supplierProductId String  @map("supplier_product_id") @db.Uuid
  quantity          Decimal @db.Decimal(14, 3)
  receivedQty       Decimal @default(0) @map("received_qty") @db.Decimal(14, 3)
  unitPrice         Int     @map("unit_price")

  purchaseOrder   PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  supplierProduct SupplierProduct @relation(fields: [supplierProductId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

// ---------------------------------------------------------------------------
// PERSONNEL, POINTAGE (Phase 5)
// ---------------------------------------------------------------------------

model Employee {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  userId          String?  @unique @map("user_id") @db.Uuid
  firstName       String   @map("first_name")
  lastName        String   @map("last_name")
  jobTitle        String?  @map("job_title")
  hourlyCost      Int?     @map("hourly_cost")
  pinHash         String?  @map("pin_hash")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  shifts        Shift[]
  timeEntries   TimeEntry[]

  @@index([establishmentId])
  @@map("employees")
}

model Shift {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  startsAt        DateTime @map("starts_at")
  endsAt          DateTime @map("ends_at")
  notes           String?

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([establishmentId, startsAt])
  @@map("shifts")
}

enum TimeEntryKind {
  CLOCK_IN
  BREAK_START
  BREAK_END
  CLOCK_OUT
}

model TimeEntry {
  id              String        @id @default(uuid()) @db.Uuid
  establishmentId String        @map("establishment_id") @db.Uuid
  employeeId      String        @map("employee_id") @db.Uuid
  kind            TimeEntryKind
  at              DateTime      @default(now())
  terminalId      String?       @map("terminal_id") @db.Uuid

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([establishmentId, at])
  @@index([employeeId, at])
  @@map("time_entries")
}

// ---------------------------------------------------------------------------
// API PUBLIQUE, WEBHOOKS (Phase 7)
// ---------------------------------------------------------------------------

model ApiKey {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  establishmentId String    @map("establishment_id") @db.Uuid
  name            String
  prefix          String // 12 premiers caractères visibles (mr_live_xxxx)
  keyHash         String    @unique @map("key_hash")
  scopes          String[]  @default([]) // orders:read, catalog:read, reports:read, stock:read, orders:write
  lastUsedAt      DateTime? @map("last_used_at")
  isActive        Boolean   @default(true) @map("is_active")
  createdById     String?   @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
  @@map("api_keys")
}

model Webhook {
  id              String    @id @default(uuid()) @db.Uuid
  establishmentId String    @map("establishment_id") @db.Uuid
  url             String
  secret          String
  events          String[]  @default([]) // order.created, order.updated, order.closed, kitchen.updated, table.updated, cash.updated, product.availability, catalog.updated, floor.updated ; "*" = tous
  description     String?
  isActive        Boolean   @default(true) @map("is_active")
  failures        Int       @default(0)
  lastStatus      Int?      @map("last_status")
  lastError       String?   @map("last_error")
  lastAt          DateTime? @map("last_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  establishment Establishment     @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  deliveries    WebhookDelivery[]

  @@index([establishmentId])
  @@map("webhooks")
}

model WebhookDelivery {
  id         String   @id @default(uuid()) @db.Uuid
  webhookId  String   @map("webhook_id") @db.Uuid
  event      String
  payload    Json
  status     Int?
  error      String?
  attempts   Int      @default(0)
  durationMs Int?     @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at")

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

// ---------------------------------------------------------------------------
// AUDIT, IDEMPOTENCE (synchro hors ligne)
// ---------------------------------------------------------------------------

model AuditLog {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  establishmentId String?  @map("establishment_id") @db.Uuid
  userId          String?  @map("user_id") @db.Uuid
  authorizedById  String?  @map("authorized_by_id") @db.Uuid // manager ayant validé par PIN
  terminalId      String?  @map("terminal_id") @db.Uuid
  action          String // order.cancel, item.void, payment.refund, price.update…
  entityType      String   @map("entity_type")
  entityId        String?  @map("entity_id")
  oldValue        Json?    @map("old_value")
  newValue        Json?    @map("new_value")
  reason          String?
  ip              String?
  createdAt       DateTime @default(now()) @map("created_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  terminal      Terminal?      @relation(fields: [terminalId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([establishmentId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model IdempotencyKey {
  key             String   @id
  establishmentId String   @map("establishment_id") @db.Uuid
  statusCode      Int      @map("status_code")
  response        Json
  createdAt       DateTime @default(now()) @map("created_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("idempotency_keys")
}

// ------------------------------------------------------------------ Suivi de service (Phase 9)
enum ServiceStepStatus {
  PENDING
  DONE
  SKIPPED
  NOT_NEEDED
}

enum ServiceReminderKind {
  BRING // commande prête à apporter
  TAKE_ORDER // table qui attend une prise de commande
  CHECK // vérification de satisfaction
  DESSERT // dessert ou café à proposer
  BILL // table prête pour l'addition
  CUSTOM
}

enum ServiceReminderStatus {
  OPEN
  DONE
  CANCELLED
}

/// Étape du parcours de service d'une table (une ligne par étape et par commande).
model TableServiceStep {
  id              String            @id @default(uuid()) @db.Uuid
  establishmentId String            @map("establishment_id") @db.Uuid
  orderId         String            @map("order_id") @db.Uuid
  key             String
  label           String
  sortOrder       Int               @default(0) @map("sort_order")
  status          ServiceStepStatus @default(PENDING)
  reason          String?
  doneAt          DateTime?         @map("done_at")
  doneById        String?           @map("done_by_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, key])
  @@index([establishmentId])
  @@map("table_service_steps")
}

/// Rappel de service : action à faire pour une table, avec priorité, échéance et responsable.
model ServiceReminder {
  id              String                @id @default(uuid()) @db.Uuid
  establishmentId String                @map("establishment_id") @db.Uuid
  orderId         String                @map("order_id") @db.Uuid
  tableId         String?               @map("table_id") @db.Uuid
  kind            ServiceReminderKind
  label           String
  priority        Int                   @default(5)
  dueAt           DateTime              @map("due_at")
  status          ServiceReminderStatus @default(OPEN)
  assignedToId    String?               @map("assigned_to_id") @db.Uuid
  ticketId        String?               @map("ticket_id") @db.Uuid
  meta            Json?
  snoozeCount     Int                   @default(0) @map("snooze_count")
  snoozedById     String?               @map("snoozed_by_id") @db.Uuid
  doneAt          DateTime?             @map("done_at")
  doneById        String?               @map("done_by_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([establishmentId, status, dueAt])
  @@index([orderId])
  @@map("service_reminders")
}

/// Fichiers envoyés (photos de plats, formules, couverture du site) : stockés en base, servis par /api/uploads/:id
model Upload {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  mime            String
  size            Int
  width           Int?
  height          Int?
  data            Bytes
  createdAt       DateTime @default(now()) @map("created_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
  @@map("uploads")
}

/// Demandes de démonstration envoyées depuis le site vitrine (www.manaresto.com)
model DemoRequest {
  id             String   @id @default(uuid()) @db.Uuid
  restaurantName String   @map("restaurant_name")
  contactName    String   @map("contact_name")
  phone          String
  email          String
  commune        String
  kind           String // RESTAURANT | ROULOTTE | SNACK | BAR | CAFE | AUTRE
  message        String?
  consent        Boolean  @default(false)
  status         String   @default("NEW") // NEW | CONTACTED | DONE
  ip             String?
  userAgent      String?  @map("user_agent")
  emailSent      Boolean  @default(false) @map("email_sent")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("demo_requests")
}

// ---------------------------------------------------------------------------
// CONSOLE PLATEFORME : activité des comptes et e-mails envoyés aux restaurateurs
// ---------------------------------------------------------------------------

/**
 * Temps d'utilisation par utilisateur et par jour (battement de cœur minute par minute).
 */
model ActivityDay {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  day            DateTime @db.Date
  minutes        Int      @default(0)
  lastAt         DateTime @default(now()) @map("last_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([organizationId, day])
  @@map("activity_days")
}

/**
 * Journal des e-mails envoyés par la plateforme (bienvenue, fin d'essai, message manuel).
 */
model PlatformEmail {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  kind           String // WELCOME | TRIAL_REMINDER | TRIAL_EXPIRED | MANUAL
  to             String
  subject        String
  status         String // SENT | FAILED
  error          String?
  messageId      String?  @map("message_id") // référence de l'envoi chez le prestataire (Brevo) : retrouver le message dans ses journaux
  sentById       String?  @map("sent_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("platform_emails")
}

/**
 * Tentatives et appels limités (connexion, PIN, formulaires publics, API) : conservés aux redémarrages.
 */
model RateHit {
  id  BigInt   @id @default(autoincrement())
  key String
  at  DateTime @default(now())

  @@index([key, at])
  @@map("rate_hits")
}

/// Demande de déblocage d'une option, faite depuis le programme ; traitée depuis la console plateforme
model OptionRequest {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  option         String
  requestedById  String?   @map("requested_by_id") @db.Uuid
  status         String    @default("PENDING") // PENDING, DONE, DECLINED
  createdAt      DateTime  @default(now()) @map("created_at")
  handledAt      DateTime? @map("handled_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@map("option_requests")
}

/// Prix mensuel d'une option (F CFP), réglé dans la console ; absent = « sur demande »
model OptionPrice {
  option    String   @id
  monthly   Int?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("option_prices")
}

/// Secrets de la plateforme gardés en base (ex. compte Let's Encrypt des boîtiers de secours)
model PlatformSecret {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_secrets")
}

/// Analyses de l'Assistant IA (qualité, semaine à venir), gardées pour l'historique et pour ne pas les payer deux fois
model AiReport {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  kind            String // quality, week
  periodFrom      DateTime @map("period_from")
  periodTo        DateTime @map("period_to")
  data            Json
  model           String
  createdById     String?  @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([establishmentId, kind, createdAt])
  @@map("ai_reports")
}

/**
 * Modification ou annulation d'un plat déjà envoyé en cuisine : la cuisine la reçoit comme telle (jamais une
 * nouvelle commande), la voit (« vue »), puis l'applique ; la salle suit chaque étape. L'ancienne version reste
 * dans l'historique.
 */
model KitchenChange {
  id              String    @id @default(uuid()) @db.Uuid
  establishmentId String    @map("establishment_id") @db.Uuid
  orderId         String    @map("order_id") @db.Uuid
  orderItemId     String?   @map("order_item_id") @db.Uuid
  ticketId        String?   @map("ticket_id") @db.Uuid
  stationId       String?   @map("station_id") @db.Uuid
  kind            String // MODIFY, CANCEL
  urgent          Boolean   @default(false) // le plat était déjà en préparation ou prêt
  stage           String // où en était le plat : NEW, ACCEPTED, PREPARING, READY, SERVED
  itemName        String    @map("item_name")
  quantity        Int       @default(1)
  tableName       String?   @map("table_name")
  orderNumber     String    @map("order_number")
  removed         String[]  @default([])
  added           String[]  @default([])
  note            String?
  reason          String?
  status          String    @default("REQUESTED") // REQUESTED, SEEN, APPLIED
  requestedById   String?   @map("requested_by_id") @db.Uuid
  requestedByName String?   @map("requested_by_name")
  createdAt       DateTime  @default(now()) @map("created_at")
  seenAt          DateTime? @map("seen_at")
  appliedAt       DateTime? @map("applied_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([establishmentId, status])
  @@index([orderId])
  @@map("kitchen_changes")
}

/// Fréquentation : pages vues du site vitrine (mesure anonyme sans cookie), connexions, inscriptions et visites de la démo.
/// Aucune adresse IP n'est conservée : `visitor` est une empreinte tronquée qui change chaque jour.
model SiteEvent {
  id             String   @id @default(uuid()) @db.Uuid
  at             DateTime @default(now())
  kind           String // view | click | login | signup | demo
  method         String? // connexion : password | pin | invite | offline | box ; clic : signup | login | demo | contact…
  path           String?
  referrer       String? // domaine d'origine
  device         String? // mobile | tablet | desktop
  visitor        String?
  utmSource      String?  @map("utm_source")
  utmCampaign    String?  @map("utm_campaign")
  organizationId String?  @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid

  @@index([kind, at])
  @@index([at])
  @@map("site_events")
}

// ─── Hygiène & HACCP (option payante « hygiene ») ───────────────────────────────

/// Équipement dont on relève la température (réfrigérateur, congélateur, maintien au chaud). Températures en dixièmes de °C.
model HygieneEquipment {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  name            String
  kind            String   @default("FRIDGE") // FRIDGE, FREEZER, HOT, OTHER
  minTemp         Int      @map("min_temp")
  maxTemp         Int      @map("max_temp")
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  establishment Establishment        @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  readings      TemperatureReading[]

  @@index([establishmentId])
  @@map("hygiene_equipment")
}

/// Relevé de température : hors limites, une action corrective est obligatoire.
model TemperatureReading {
  id               String   @id @default(uuid()) @db.Uuid
  establishmentId  String   @map("establishment_id") @db.Uuid
  equipmentId      String   @map("equipment_id") @db.Uuid
  value            Int // dixièmes de °C
  minTemp          Int      @map("min_temp") // limites en vigueur au moment du relevé
  maxTemp          Int      @map("max_temp")
  compliant        Boolean
  correctiveAction String?  @map("corrective_action")
  userId           String?  @map("user_id") @db.Uuid
  takenAt          DateTime @default(now()) @map("taken_at")

  establishment Establishment    @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  equipment     HygieneEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([establishmentId, takenAt])
  @@index([equipmentId, takenAt])
  @@map("temperature_readings")
}

/// Tâche du plan de nettoyage.
model CleaningTask {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  name            String
  area            String? // zone : cuisine, salle, plonge…
  frequency       String   @default("DAILY") // DAILY, WEEKLY, MONTHLY
  instructions    String?
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  logs          CleaningLog[]

  @@index([establishmentId])
  @@map("cleaning_tasks")
}

model CleaningLog {
  id              String   @id @default(uuid()) @db.Uuid
  establishmentId String   @map("establishment_id") @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  userId          String?  @map("user_id") @db.Uuid
  note            String?
  doneAt          DateTime @default(now()) @map("done_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  task          CleaningTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([establishmentId, doneAt])
  @@index([taskId, doneAt])
  @@map("cleaning_logs")
}

/// Traçabilité : réception de marchandise (lot, DLC, température à réception) ou préparation maison (DLC, étiquette).
model TraceRecord {
  id              String    @id @default(uuid()) @db.Uuid
  establishmentId String    @map("establishment_id") @db.Uuid
  kind            String // RECEPTION, PREPARATION
  name            String
  supplierName    String?   @map("supplier_name")
  lotNumber       String?   @map("lot_number")
  quantity        String?
  temperature     Int? // dixièmes de °C, à réception
  compliant       Boolean   @default(true)
  issue           String? // non-conformité constatée et suite donnée
  madeAt          DateTime  @default(now()) @map("made_at") // réception ou fabrication
  useBy           DateTime? @map("use_by") // date limite de consommation
  closedAt        DateTime? @map("closed_at")
  closedReason    String?   @map("closed_reason") // USED, DISCARDED
  userId          String?   @map("user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([establishmentId, madeAt])
  @@index([establishmentId, useBy])
  @@map("trace_records")
}
