# syntax=docker/dockerfile:1.7
# Static site (HTML/CSS/JS, ou build d'un SPA Vite/React/Vue)
FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN if [ -f package.json ]; then npm ci --no-audit --no-fund || true; fi
COPY . .
RUN if [ -f package.json ] && grep -q '"build"' package.json; then npm run build; fi

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html 2>/dev/null || \
  COPY --from=builder /app/build /usr/share/nginx/html 2>/dev/null || \
  COPY --from=builder /app/. /usr/share/nginx/html
EXPOSE __APP_PORT__
RUN sed -i "s/listen.*80;/listen __APP_PORT__;/g" /etc/nginx/conf.d/default.conf
