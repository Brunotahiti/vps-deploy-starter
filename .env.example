# ManaResto — variables d'environnement (développement local)
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manaresto

# Secret utilisé pour signer les cookies de session (32+ caractères aléatoires)
SESSION_SECRET=change-me-please-use-openssl-rand-base64-32

# Durée de session (heures)
SESSION_TTL_HOURS=12

# Seed de démonstration (Le Mana Beach) au premier démarrage : true/false
SEED_DEMO=true

# Envoi d'e-mails (reçus PDF, invitations, bienvenue, fin d'essai, messages de la console).
# Recommandé : relais SMTP Brevo avec l'adresse contact@manaresto.com (domaine authentifié chez Brevo).
# SMTP_USER = identifiant SMTP affiché dans Brevo (Paramètres > SMTP & API), SMTP_PASS = clé SMTP générée dans Brevo.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="ManaResto <contact@manaresto.com>"

# Assistant IA (option payante) : analyses rédigées par Claude (Anthropic). Clé à créer sur console.anthropic.com
# (paiement à l'usage, quelques centimes par analyse). Sans clé, les prévisions et la commande proposée fonctionnent,
# seules l'analyse qualité et les conseils de la semaine restent indisponibles.
# ANTHROPIC_API_KEY=

# Console plateforme (/platform) : adresses des administrateurs ManaResto, séparées par des virgules.
# Ces adresses doivent correspondre à un compte ManaResto existant (celui avec lequel vous vous connectez).
# PLATFORM_ADMIN_EMAILS=contact@manaresto.com

# Alertes à l'équipe (nouvelle inscription, demande de démonstration). Par défaut : contact@manaresto.com
# PLATFORM_NOTIFY_EMAILS=contact@manaresto.com,vous@icloud.com

# Relances automatiques (rappel 3 jours avant la fin de l'essai, puis « essai expiré ») : actives en production.
# LIFECYCLE_EMAILS=off pour les désactiver.
# LIFECYCLE_EMAILS=on

# Notifications push « plat prêt » (Web Push) sur les téléphones du personnel : clés VAPID à générer une fois
# avec `pnpm push:keys` (ou openssl, voir docs/DEPLOIEMENT.md). Sans clés, le bouton « Alertes plat prêt » n'apparaît pas.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@manaresto.com

# Temps réel partagé entre plusieurs instances (Phase 7) — facultatif
# REDIS_URL=redis://manaresto-redis:6379

# Boîtier de secours (mini-PC du restaurant) : adresse HTTPS des boîtiers sur le réseau du restaurant.
# Zone DNS gérée chez Cloudflare ; jeton API avec le seul droit « Zone > DNS > Modifier » sur cette zone.
# Sans ces réglages, les boîtiers fonctionnent en HTTP (sans connexion par PIN hors ligne ni installation de l'application).
# BOX_DNS_ZONE=box.manaresto.com
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=
# ACME_EMAIL=contact@manaresto.com

# Limites de mémoire (serveur partagé, production Docker) — chaque programme est réglé pour tenir DANS sa limite.
# Mémoire à prévoir sur le serveur : application + base + site ≈ 1,35 Go en continu,
# plus 0,5 Go quelques secondes pendant un déploiement ou le rafraîchissement horaire de la démo.
# Si vous augmentez une limite, ajustez le réglage associé (Node.js ≈ 2/3 de la limite ; PostgreSQL : cache ≈ 1/4).
# APP_MEM_LIMIT=768m           # application ; APP_HEAP_MB=512 (mémoire de Node.js)
# APP_HEAP_MB=512
# DB_MEM_LIMIT=512m            # PostgreSQL ; réglages ci-dessous
# DB_SHARED_BUFFERS=128MB
# DB_EFFECTIVE_CACHE_SIZE=320MB
# DB_WORK_MEM=4MB
# DB_MAINTENANCE_WORK_MEM=32MB
# DB_MAX_CONNECTIONS=40        # application 10 + démo 20 + sauvegarde : ne pas descendre sous 35
# MIGRATE_MEM_LIMIT=512m       # migrations et démo ; MIGRATE_HEAP_MB=320
# MIGRATE_HEAP_MB=320
# SITE_MEM_LIMIT=64m           # site vitrine (nginx)
# REDIS_MEM_LIMIT=128m         # facultatif ; REDIS_MAXMEMORY=96mb
# REDIS_MAXMEMORY=96mb
