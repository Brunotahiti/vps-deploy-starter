# ManaResto — variables d'environnement (développement local)
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manaresto

# Secret utilisé pour signer les cookies de session (32+ caractères aléatoires)
SESSION_SECRET=change-me-please-use-openssl-rand-base64-32

# Durée de session (heures)
SESSION_TTL_HOURS=12

# Seed de démonstration (Le Mana Beach) au premier démarrage : true/false
SEED_DEMO=true

# Envoi des reçus PDF par e-mail (facultatif). Exemple Hostinger : smtp.hostinger.com, port 465, SMTP_SECURE=true
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=contact@votre-restaurant.pf
# SMTP_PASS=
# SMTP_FROM="Le Mana Beach <contact@votre-restaurant.pf>"
